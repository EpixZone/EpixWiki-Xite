{
  "db_name": "EpixWiki",
  "db_file": "data/epixwiki.db",
  "version": 4,
  "maps": {
    "users/.+/pages.json$": {
      "to_table": [{"node": "post", "table": "pages"}]
    },
    "users/.+/data.json$": {
      "to_table": [{"node": "pages", "table": "pages"}]
    },
    "users/.+/content.json$": {
      "to_keyvalue": ["cert_user_id"]
    }
  },
  "tables": {
    "pages": {
      "cols": [
        ["id", "TEXT"],
        ["slug", "TEXT"],
        ["title", "TEXT"],
        ["body", "TEXT"],
        ["summary", "TEXT"],
        ["date_added", "INTEGER"],
        ["clock", "INTEGER"],
        ["supersedes", "INTEGER"],
        ["post_id", "INTEGER"],
        ["author", "TEXT"],
        ["deleted", "INTEGER"],
        ["sign", "TEXT"],
        ["json_id", "INTEGER REFERENCES json (json_id)"]
      ],
      "indexes": [
        "CREATE INDEX wiki_page_slug ON pages(slug, date_added DESC)",
        "CREATE INDEX wiki_page_revision ON pages(id)",
        "CREATE INDEX wiki_page_file ON pages(json_id)",
        "CREATE INDEX wiki_page_lineage ON pages(json_id, post_id, clock)"
      ],
      "schema_changed": 1790791200
    }
  }
}
